{
  "name": "agent-tool-router",
  "version": "0.1.0",
  "private": true,
  "description": "A small, abstention-aware tool routing core with pluggable decision providers.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "npm run build && node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
